<Window x:Class="WorldcrossInfoDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Worldcross Info Display" Width="1280" Height="820" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="WORLDcross INFO DISPLAY" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Relay-driven OBS standings" Foreground="#69747B"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Relay:" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox Text="{Binding RelayStatus, Mode=OneWay}" IsReadOnly="True" Width="230" Margin="0,0,10,0"/>
        <TextBlock Text="OBS:" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox Text="{Binding ObsStatus, Mode=OneWay}" IsReadOnly="True" Width="110" Margin="0,0,8,0"/>
        <Button Content="Connect / Disconnect" Click="ConnectObs_Click"/><Button Content="Refresh sources" Click="RefreshObs_Click"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <Grid Grid.Column="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8"><TextBlock Text="Worldcross players" FontSize="17" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Show / Hide selected" Click="ToggleVisibility_Click"/></DockPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Players}" SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
          <DataGrid.Columns><DataGridTextColumn Header="Player" Binding="{Binding Player.Name}" Width="2*"/><DataGridTextColumn Header="Last play score" Binding="{Binding Player.LastPlayScore, StringFormat={}{0:0.##}}" Width="*"/><DataGridTextColumn Header="Label" Binding="{Binding DisplayLabel}" Width="*"/><DataGridTextColumn Header="Display" Binding="{Binding DisplayState}" Width="*"/><DataGridTextColumn Header="SteamID64" Binding="{Binding Player.SteamId64}" Width="2*"/></DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding TotalPlayers, StringFormat=Total: {0}}" Foreground="#69747B" Margin="0,8,0,0"/>
      </Grid>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Display template" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock Text="Prefix"/><TextBox Text="{Binding Settings.Prefix, UpdateSourceTrigger=PropertyChanged}" TextChanged="TemplateChanged" ToolTip="Emitted once before the player rows. Global placeholders: {%YYYY}, {%YY}, {%MM}, {%M}, {%m}, {%DD}, {%D}, {%d}, {%12h}, {%24h}, {%12s}, {%24s}, {%plc}, {%splc}, {%hplc}, {%tpc}."/>
          <TextBlock Text="Repeat" Margin="0,8,0,0"/><TextBox Text="{Binding Settings.Repeat, UpdateSourceTrigger=PropertyChanged}" TextChanged="TemplateChanged" AcceptsReturn="True" Height="64" TextWrapping="Wrap" ToolTip="Expanded once per shown player. Player placeholders: {%n} name; {%s} rounded score; {%S} score with two decimals; {%l}, {%L}, {%lx} labels (FC=FC/FULL COMBO/[FC], CLEAR=empty/CLEARED/empty, AC=AC/ALL CRITICAL/[AC], VS=VS/PERFECT/[VS]); {%r}, {%rth}, {%R} standing; {%r1}, {%rth1}, {%R1} winner aliases. Global placeholders are also available."/>
          <TextBlock Text="Suffix" Margin="0,8,0,0"/><TextBox Text="{Binding Settings.Suffix, UpdateSourceTrigger=PropertyChanged}" TextChanged="TemplateChanged" ToolTip="Emitted once after the player rows. Global placeholders: {%YYYY}, {%YY}, {%MM}, {%M}, {%m}, {%DD}, {%D}, {%d}, {%12h}, {%24h}, {%12s}, {%24s}, {%plc}, {%splc}, {%hplc}, {%tpc}."/>
          <WrapPanel Margin="0,8,0,0"><StackPanel Width="130" Margin="0,0,10,0"><TextBlock Text="Repeat cap"/><TextBox Text="{Binding Settings.RepeatCap, UpdateSourceTrigger=PropertyChanged}" TextChanged="TemplateChanged"/></StackPanel><StackPanel Width="130"><TextBlock Text="Play count"/><TextBox Text="{Binding Settings.PlayCount, UpdateSourceTrigger=PropertyChanged}" TextChanged="TemplateChanged" ToolTip="Editable play-count offset used by {%tpc}. Each new live gameplay result increments this value."/></StackPanel></WrapPanel>
          <CheckBox Content="Show new players by default" IsChecked="{Binding Settings.DefaultDisplayShown, UpdateSourceTrigger=PropertyChanged}" Checked="TemplateChanged" Unchecked="TemplateChanged" Margin="0,10,0,8"/>
          <TextBlock Text="OBS source name"/><ComboBox ItemsSource="{Binding ObsTextSources}" Text="{Binding Settings.ObsSourceName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True"/>
          <TextBlock Text="OBS WebSocket URL" Margin="0,8,0,0"/><TextBox Text="{Binding Settings.ObsUrl, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="OBS password" Margin="0,8,0,0"/><PasswordBox PasswordChanged="PasswordChanged"/>
          <TextBlock Text="Game path" Margin="0,8,0,0"/><TextBox Text="{Binding Settings.GamePath, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Text="Relay executable (optional)" Margin="0,8,0,0"/><TextBox Text="{Binding Settings.RelayExecutablePath, UpdateSourceTrigger=PropertyChanged}"/>
          <Button Content="Apply template" Click="Apply_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,14,0,4"/><TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="{Binding EventStatus, Mode=OneWay}" Foreground="#69747B" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBox Grid.Row="2" Text="{Binding StatusText, Mode=OneWay}" IsReadOnly="True" Margin="0,12,0,0"/>
  </Grid>
</Window>
